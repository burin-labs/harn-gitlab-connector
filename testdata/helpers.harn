import {
  activate,
  call,
  init,
  kinds,
  normalize_inbound,
  payload_schema,
  provider_id,
  shutdown,
} from "../src/lib"

pub fn gitlab_headers(token: any, event: any, event_uuid: any = "event-uuid-1") {
  return {"x-gitlab-event": event, "x-gitlab-event-uuid": event_uuid, "x-gitlab-token": token}
}

/**
 * Build a raw inbound envelope WITHOUT embedding the signing secret. Tests must seed the secret via `init(harness, {signing_secret: secret})` before calling normalize_inbound.
 */
pub fn signed_raw(token: any, body: any, event: any, extra: any = nil) {
  return (extra ?? {}) + {body_text: body, headers: gitlab_headers(token, event)}
}

/** Read a fixture JSON body from the test fixtures directory. */
pub fn fixture_body(fs: HarnessFs, name: any) {
  return fs.read_text(fs.source_dir() + "/../tests/fixtures/webhooks/" + name + ".json")
}

/** Build a signed raw inbound envelope from a named fixture. */
pub fn fixture_raw(fs: HarnessFs, name: any, token: any, event: any, extra: any = nil) {
  return signed_raw(token, fixture_body(fs, name), event, extra)
}

pub fn assert_gitlab_interface(harness: Harness) {
  shutdown(harness)
  expect_eq(provider_id(), "gitlab", "provider id")
  expect_eq(kinds()[0], "webhook", "webhook kind")
  expect_eq(payload_schema().harn_schema_name, "GitLabEventPayload", "payload schema name")
  const initialized = init(harness, {signing_secret: "test-secret"})
  expect(initialized.initialized, "init stores state")
  const activated = activate(
    harness,
    [{id: "primary", path: "/gitlab/events", secrets: {signing_secret: "test-secret"}}],
  )
  expect_eq(activated.bindings, 1, "activate counts bindings")
}

pub fn gitlab_call(harness: Harness, method: any, args: any) {
  return call(harness, method, args)
}

pub fn gitlab_normalize(harness: Harness, raw: any) {
  return normalize_inbound(harness, raw)
}

/**
 * Require that a smoke-test condition holds. Helper `fn`s are not test
 * pipelines, so `assert` does not belong here (HARN-LNT-025).
 */
fn expect(condition: any, message: any = "expectation failed") {
  require condition, message
}

/** Require that two smoke-test values are equal, reporting both on failure. */
fn expect_eq(actual: any, expected: any, message: any = "values differ") {
  require actual == expected,
    message + ": expected " + to_string(expected) + ", got "
    + to_string(actual)
}
